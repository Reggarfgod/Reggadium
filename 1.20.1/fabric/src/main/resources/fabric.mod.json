{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://reggarf-mods.vercel.app/"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",

  "entrypoints": {
    "client": [
      "com.reggarf.mods.reggadium.ReggadiumFabric"
    ],
    "modmenu": [
      "com.reggarf.mods.reggadium.compat.ReggadiumModMenuCompat"
    ]
  },

  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=1.20.1 <1.21",
    "java": ">=${java_version}"
  },

  "suggests": {
    "sodium": "*",
    "embeddium": "*",
    "indium": "*",
    "create": "*",
    "modmenu": "*"
  }
}
